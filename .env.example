# Salin menjadi .env — dibaca Vite saat build/dev (src/lib/config.ts).

# Alamat backend Fablerace API. Dibiarkan kosong pun aman selama mock aktif.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# true  = seluruh data dilayani mock in-memory (panel bisa dijelajah penuh
#         tanpa backend; kredensial demo ada di laman login).
# false = terhubung ke backend nyata di VITE_API_BASE_URL.
VITE_USE_MOCK=true
